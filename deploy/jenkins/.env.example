# Copy to deploy/jenkins/.env (gitignored) and fill in.
JENKINS_ADMIN_PASSWORD=CHANGE_ME
DOCKERHUB_USER=your-dockerhub-user
# Jenkins reads the Docker Hub token from Vault, so it isn't in this file. Store it once with
#   ansible-playbook ... site.yml --tags vault -e vault_jenkins_role_id=<VAULT_ROLE_ID> #     -e vault_jenkins_secret_id=<VAULT_SECRET_ID> -e dockerhub_user=<user> -e dockerhub_token=<token>
# (Docker Hub > Account settings > Personal access tokens, read/write).
# Vault on the minikube node (NodePort 30820): http://<node ip>:30820
VAULT_ADDR=
# Any two random strings, e.g. `openssl rand -hex 16`; the vault role registers the same ones.
VAULT_ROLE_ID=CHANGE_ME
VAULT_SECRET_ID=CHANGE_ME
# The app's ADMIN_EMAIL / ADMIN_PASSWORD (k8s secret gstr2b-secrets)
SMOKE_EMAIL=admin@example.com
SMOKE_PASSWORD=CHANGE_ME
# Empty = http://$(minikube ip)
APP_URL=
APP_USE_VAULT=false
# Empty = Docker Hub. localhost:5001 (+ DOCKERHUB_USER=localhost:5001) for a local registry
REGISTRY=
JENKINS_GIT_BRANCH=*/main
# minikube: kubectl config view --flatten --minify > deploy/jenkins/kubeconfig
KUBECONFIG_FILE=./kubeconfig
# Host port for the Jenkins UI
JENKINS_PORT=8081
