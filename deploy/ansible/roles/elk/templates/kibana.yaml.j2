# Open with: kubectl -n {{ elk_namespace }} port-forward svc/kibana 5601
apiVersion: v1
kind: Service
metadata:
  name: kibana
  namespace: "{{ elk_namespace }}"
  labels:
    app.kubernetes.io/name: kibana
spec:
  selector:
    app.kubernetes.io/name: kibana
  ports:
    - name: http
      port: 5601
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: kibana
  namespace: "{{ elk_namespace }}"
  labels:
    app.kubernetes.io/name: kibana
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: kibana
  template:
    metadata:
      labels:
        app.kubernetes.io/name: kibana
    spec:
      containers:
        - name: kibana
          image: "docker.elastic.co/kibana/kibana:{{ elk_version }}"
          env:
            - name: ELASTICSEARCH_HOSTS
              value: http://elasticsearch:9200
            - name: TELEMETRY_OPTIN
              value: "false"
            - name: SECURITY_SHOWINSECURECLUSTERWARNING
              value: "false"
          ports:
            - name: http
              containerPort: 5601
          startupProbe:
            httpGet:
              path: /api/status
              port: http
            periodSeconds: 10
            failureThreshold: 30
          readinessProbe:
            httpGet:
              path: /api/status
              port: http
            periodSeconds: 10
            timeoutSeconds: 5
          livenessProbe:
            httpGet:
              path: /api/status
              port: http
            periodSeconds: 30
            timeoutSeconds: 5
          resources:
            requests:
              cpu: 100m
              memory: 512Mi
            limits:
              cpu: "1"
              memory: 1Gi
