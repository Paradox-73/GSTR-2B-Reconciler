apiVersion: v1
kind: ConfigMap
metadata:
  name: logstash-pipeline
  namespace: "{{ elk_namespace }}"
data:
  logstash.conf: |
    {{ lookup('ansible.builtin.file', elk_config_dir ~ '/logstash.conf') | indent(4) }}
---
apiVersion: v1
kind: Service
metadata:
  name: logstash
  namespace: "{{ elk_namespace }}"
  labels:
    app.kubernetes.io/name: logstash
spec:
  selector:
    app.kubernetes.io/name: logstash
  ports:
    - name: beats
      port: 5044
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: logstash
  namespace: "{{ elk_namespace }}"
  labels:
    app.kubernetes.io/name: logstash
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: logstash
  template:
    metadata:
      labels:
        app.kubernetes.io/name: logstash
      annotations:
        # Restarts Logstash when deploy/elk/logstash.conf changes.
        checksum/pipeline: "{{ lookup('ansible.builtin.file', elk_config_dir ~ '/logstash.conf') | hash('sha256') }}"
    spec:
      containers:
        - name: logstash
          image: "docker.elastic.co/logstash/logstash:{{ elk_version }}"
          env:
            - name: LS_JAVA_OPTS
              value: "-Xms{{ logstash_heap }} -Xmx{{ logstash_heap }}"
            - name: XPACK_MONITORING_ENABLED
              value: "false"
          ports:
            - name: beats
              containerPort: 5044
            - name: api
              containerPort: 9600
          readinessProbe:
            httpGet:
              path: /
              port: api
            initialDelaySeconds: 30
            periodSeconds: 10
            timeoutSeconds: 5
          livenessProbe:
            httpGet:
              path: /
              port: api
            initialDelaySeconds: 90
            periodSeconds: 30
            timeoutSeconds: 5
          resources:
            requests:
              cpu: 100m
              memory: 512Mi
            limits:
              cpu: "1"
              memory: 768Mi
          volumeMounts:
            - name: pipeline
              mountPath: /usr/share/logstash/pipeline
      volumes:
        - name: pipeline
          configMap:
            name: logstash-pipeline
